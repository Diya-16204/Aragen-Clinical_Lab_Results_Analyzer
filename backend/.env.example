# Set to gemini or groq. The assignment requires a live LLM explanation.
AI_PROVIDER=groq

# Gemini configuration (use when AI_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Groq configuration (use when AI_PROVIDER=groq)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Comma-separated deployed frontend URL(s), e.g. https://your-app.vercel.app
FRONTEND_ORIGIN=
